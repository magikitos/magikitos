{
  "name": "@magikitos/adventure",
  "private": true,
  "version": "0.0.0",
  "description": "Magikitos game and local scene studio",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build.cjs",
    "audio:prepare": "node tools/prepare-audio.cjs",
    "test:audio:core": "node scripts/check-audio-core.cjs",
    "test:audio": "node scripts/check-audio-core.cjs && node scripts/check-audio-browser.cjs",
    "build:mobile": "node tools/build-mobile.cjs",
    "test:mobile:package": "node scripts/check-mobile-package.cjs",
    "mobile:sync": "npm --prefix apps/mobile run sync",
    "mobile:ios": "npm --prefix apps/mobile run open:ios",
    "mobile:android": "npm --prefix apps/mobile run open:android",
    "dev": "node tools/preview.cjs",
    "studio": "node tools/adventure-studio/server.cjs",
    "studio:diff": "node tools/adventure-studio/review.cjs",
    "test": "node scripts/test.cjs",
    "test:browser": "node scripts/check-adventure-browser.cjs",
    "test:ascua": "node scripts/check-ascua-browser.cjs",
    "test:mobility": "node scripts/check-mobility-browser.cjs",
    "test:journeys": "node scripts/check-journeys-browser.cjs",
    "test:world-controls": "node scripts/check-world-controls-browser.cjs",
    "test:embed": "node scripts/check-embed-browser.cjs",
    "test:input-mode": "node scripts/check-input-modality.cjs && node scripts/check-input-modality-browser.cjs",
    "test:chapter": "node scripts/check-chapter-browser.cjs",
    "test:residents": "node scripts/check-adventure-residents.cjs",
    "test:art": "node scripts/check-flat-art.cjs && node scripts/check-flat-art-browser.cjs",
    "test:zoom": "node scripts/check-initial-zoom-browser.cjs",
    "screenshots": "node scripts/preview-screens.cjs",
    "install:local": "node tools/install-local.cjs",
    "dev:offline": "node tools/preview.cjs --offline",
    "test:studio": "node scripts/check-studio-paths-browser.cjs",
    "test:native": "node scripts/check-native-browser.cjs",
    "test:api:local": "node scripts/check-api-local.cjs",
    "test:boundary": "node scripts/check-boundary-browser.cjs",
    "test:picnic": "node scripts/check-picnic-browser.cjs",
    "test:picnic-animation": "node scripts/check-picnic-animation-browser.cjs",
    "art:catalog": "node scripts/build-woodland-kit.cjs",
    "art:cast": "php scripts/prepare-adventure-cast.php",
    "art:islet": "php scripts/prepare-adventure-islet.php",
    "art:doorways": "php scripts/prepare-adventure-doorways.php",
    "art:review": "php scripts/audit-woodland-art.php",
    "test:woodland": "node scripts/check-woodland-browser.cjs",
    "test:gallery": "node scripts/check-studio-gallery-browser.cjs",
    "review:woodland": "node scripts/review-woodland-browser.cjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.60.0",
    "three": "0.186.0"
  }
}
