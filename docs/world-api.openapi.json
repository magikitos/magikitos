    "/discover": {
      "get": {
        "operationId": "worldDiscover",
        "summary": "Six pulse-ranked pieces with exploration slots",
        "parameters": [
          {
            "name": "lang",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Locale"
            }
          },
          {
            "name": "kind",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Kind"
            }
          },
          {
            "name": "round",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000,
              "default": 1
            }
          },
          {
            "name": "exclude",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 6000,
              "pattern": "^$|^[0-9]+(,[0-9]+)*$"
            },
            "description": "Last 500 unique positive IDs used"
          }
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "JSON response",
