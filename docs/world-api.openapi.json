          {}
        ],
        "requestBody": {
          "required": true,
          "description": "JSON object, at most 32768 bytes",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "lang": {
                    "$ref": "#/components/schemas/Locale"
                  },
                  "term_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "texto": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "csrf_token": {
                    "type": "string"
                  },
                  "turnstile_token": {
                    "type": "string"
                  }
                },
                "required": [
                  "lang",
                  "term_id",
                  "texto",
                  "csrf_token"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "texto"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "texto": {
                      "type": "string"
                    },
                    "token": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "despedida": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "ok": {
            "const": false
          },
          "error": {
            "type": "string"
          }
        }
      },
      "Piece": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "voiceId",
          "kind",
          "lang",
          "name",
          "handle",
          "authorUrl",
          "title",
          "summary",
          "url",
          "audio",
          "duration",
          "region",
          "regionSlug",
          "category",
          "rating"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "voiceId": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "kind": {
            "$ref": "#/components/schemas/Kind"
          },
          "lang": {
            "$ref": "#/components/schemas/Locale"
          },
          "name": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "authorUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 300
          },
          "summary": {
            "type": "string",
            "maxLength": 2000
          },
          "url": {
            "type": "string"
          },
          "audio": {
            "type": [
              "string",
              "null"
            ]
          },
          "duration": {
            "type": "number",
            "minimum": 0,
            "description": "Seconds"
          },
          "region": {
            "type": [
              "string",
              "null"
            ]
          },
          "regionSlug": {
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "rating": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 1,
            "maximum": 5
          }
        }
      },
      "Locale": {
        "type": "string",
        "enum": [
          "es",
          "en",
          "de",
          "fr",
          "it",
          "pt"
        ]
      },
      "Kind": {
        "type": "string",
        "enum": [
          "cuento",
          "chiste",
          "expresion"
        ]
      },
      "Product": {
        "type": "object",
        "required": [
          "id",
          "name",
          "price",
          "currency",
          "quantity",
          "image",
          "url"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "integer",
            "minimum": 0,
            "description": "EUR cents, not game currency"
          },
          "currency": {
            "const": "EUR"
          },
          "quantity": {
            "type": "integer"
          },
          "image": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string"
          }
        }
      },
      "Sheet": {
        "type": "object",
        "required": [
          "id",
          "title",
          "image",
          "thumb"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "description": "Localized description of the sheet; the artwork itself has no language"
          },
          "image": {
            "type": "string",
            "description": "Full-size AVIF master, for viewing and printing"
          },
          "thumb": {
            "type": "string",
            "description": "300px AVIF variant for grids; falls back to the master when absent"
          }
        }
      },
      "User": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "avatar_url": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "description": "Public contributor identity; no private fields"
      },
      "Identity": {
        "type": "object",
        "required": [
          "ok",
          "created",
          "user",
          "token"
        ],
        "properties": {
          "ok": {
            "const": true
          },
          "created": {
            "type": "boolean"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "token": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Thread": {
        "type": "object",
        "properties": {
          "mensajes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "de": {
                  "type": "string"
                },
                "texto": {
                  "type": "string"
                },
                "cuando": {
                  "type": "string"
                }
              }
            }
          },
          "modo": {
            "type": "string"
          }
        },
        "description": "Existing private guardian-thread DTO; may include reclaim/publication hints owned by the website"
      },
      "Bootstrap": {
        "type": "object",
        "required": [
          "ok",
          "locale",
          "destinations",
          "capabilities",
          "limits"
        ],
        "properties": {
          "ok": {
            "const": true
          },
          "locale": {
            "$ref": "#/components/schemas/Locale"
          },
          "destinations": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "capabilities": {
            "type": "object",
            "properties": {
              "identity": {
                "type": "boolean"
              },
              "ratings": {
                "type": "boolean"
              },
              "guardian": {
                "type": "boolean"
              },
              "turnstileSiteKey": {
                "type": "string"
              }
            }
          },
          "limits": {
            "type": "object",
            "properties": {
              "pageSize": {
                "const": 24
              },
              "discoverySize": {
                "const": 6
              },
              "guardianText": {
                "const": 300
              }
            }
          }
        }
      },
      "Batch": {
        "type": "object",
        "required": [
          "ok",
          "items"
        ],
        "properties": {
          "ok": {
            "const": true
          },
          "items": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "$ref": "#/components/schemas/Piece"
            }
          }
        }
      },
      "Page": {
        "type": "object",
        "required": [
          "ok",
          "items",
          "nextCursor"
        ],
        "properties": {
          "ok": {
            "const": true
          },
          "items": {
            "type": "array",
            "maxItems": 24,
            "items": {
              "$ref": "#/components/schemas/Piece"
            }
          },
          "nextCursor": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 10000
          }
        }
      },
      "Index": {
        "type": "object",
        "required": [
          "ok",
          "items"
        ],
        "properties": {
          "ok": {
            "const": true
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "count",
                "url"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "count": {
                  "type": "integer",
                  "minimum": 0
                },
                "url": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Catalog": {
        "type": "object",
        "required": [
          "ok",
          "items",
          "nextCursor"
        ],
        "properties": {
          "ok": {
            "const": true
          },
          "items": {
            "type": "array",
            "maxItems": 24,
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/Product"
                },
                {
                  "$ref": "#/components/schemas/Sheet"
                }
              ]
            }
          },
          "nextCursor": {
            "type": [
              "integer",
              "null"
            ],
            "maximum": 10000
          }
        }
      }
    }
  }
}
