          "using": [
            "bottle",
            "knife",
            "twig",
            "leaf"
          ]
        },
        "effects": [
          {
            "type": "presentation",
            "sequence": "work",
            "props": [
              "bottle",
              "knife",
              "twig",
              "leaf"
            ],
            "result": "boat",
            "duration": 2.5
          },
          {
            "type": "item",
            "item": "bottle",
            "amount": -1
          },
          {
            "type": "item",
            "item": "twig",
            "amount": -2
          },
          {
            "type": "item",
            "item": "leaf",
            "amount": -2
          },
          {
            "type": "item",
            "item": "boat",
            "amount": 1
          },
          {
            "type": "flag",
            "flag": "boatBuilt"
          },
          {
            "type": "dialogue",
            "key": "boatReady"
          },
          {
            "type": "sound",
            "key": "found"
          }
        ]
      },
      {
        "action": "board",
        "when": {
          "items": {
            "boat": 1
          }
        },
        "effects": [
          {
            "type": "navigation",
            "mode": "boat"
          }
        ]
      },
      {
        "when": {
          "items": {
            "boat": 1
          }
        },
        "effects": [
          {
            "type": "dialogue",
            "key": "dockReady"
          }
        ]
      },
      {
        "effects": [
          {
            "type": "dialogue",
            "key": "boatRecipe"
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "board",
        "label": "boardBottle",
        "when": {
          "items": {
            "boat": 1
          }
        }
      },
      {
        "id": "craft",
        "label": "craftBottle",
        "when": {
          "items": {
            "bottle": 1,
            "knife": 1,
            "twig": 2,
            "leaf": 2
          },
          "maxItems": {
            "boat": 0
          }
        }
      }
    ]
