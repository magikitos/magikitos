    ],
    "rules": [
      {
        "when": {
          "maxItems": {
            "bottle": 0,
            "boat": 0
          }
        },
        "effects": [
          {
            "type": "item",
            "item": "bottle",
            "amount": 1
          },
          {
            "type": "dialogue",
            "key": "bottleFound"
          },
          {
            "type": "sound",
            "key": "found"
          }
        ]
      },
      {
        "effects": [
          {
            "type": "dialogue",
            "key": "binEmpty"
          }
        ]
      }
    ]
  },
  "river-dock": {
    "sprite": "sign",
    "label": "riverDock",
    "solid": [
      -0.4,
      -0.5,
      0.8,
      0.7
    ],
    "edgeSlide": true,
    "rules": [
      {
        "action": [
          "craft",
          "use"
        ],
        "when": {
          "items": {
            "bottle": 1,
            "knife": 1,
            "twig": 2,
            "leaf": 2
          },
          "maxItems": {
            "boat": 0
